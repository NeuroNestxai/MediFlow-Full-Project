# MediFlow AI — Environment variable template
#
# This file lists the environment variables the app will need in FUTURE
# stages. Nothing here is wired up yet — the current build uses mock data
# only and makes no external network calls. Copy this file to `.env.local`
# and fill in real values only when you actually connect these services.
#
# Never commit `.env.local` (or any file with real values) to source control.

# ---------------------------------------------------------------------------
# Supabase (NOT YET CONNECTED)
# Used in a future stage for auth, database, and storage.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client/browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# n8n (NOT YET CONNECTED)
# Used in a future stage for workflow automation (e.g. reminders, follow-up
# scheduling). Treat the webhook URL as a secret — it can trigger workflows.
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI provider (NOT YET CONNECTED)
# Used in a future stage for the MediFlow AI assistant (Flo). Server-only.
# ---------------------------------------------------------------------------
AI_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# App-level
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development

# n8n Ask MediFlow chat webhook (server-side only; never NEXT_PUBLIC)
N8N_CHAT_WEBHOOK_URL=
