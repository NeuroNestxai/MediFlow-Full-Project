    <string name="permission_location_body">Needed to go online, match you with nearby orders and share your position during deliveries. Tracking stops when you go offline.</string>
    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_body">Alerts you about new offers when the app is in the background, and shows that tracking is active.</string>
    <string name="permission_background_title">Location “all the time”</string>
    <string name="permission_background_body">Optional. Lets Android resume location sharing if it restarts the app while you\'re online. Never used while you\'re offline.</string>
