# Copy to infra/.env and adjust. Never commit real secrets.
# ── Core ──
NODE_ENV=development            # production refuses unsafe settings (see backend/src/config.ts)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_PEPPER=change-me
FILE_SIGNING_SECRET=change-me
OTP_DEV_ECHO=true               # dev only: returns the SMS code in the API response. MUST be false in production.
PUBLIC_API_URL=http://localhost:4000
MERCHANT_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
POSTGRES_PASSWORD=postgres

# ── Payments (DECISIONS D-017) ──
PAYMENT_PROVIDER=mock           # mock | thawani
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_URL=https://uatcheckout.thawani.om/pay
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=

# ── SMS OTP (DECISIONS D-023) ──
SMS_PROVIDER=console            # console | http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=Qabnah

# ── WhatsApp Cloud API (DECISIONS D-022) ──
WHATSAPP_PROVIDER=console       # console | cloud
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Admin security ──
REQUIRE_ADMIN_MFA=false         # MUST be true in production (enforced): admin APIs need a TOTP second factor
MFA_ENCRYPTION_KEY=change-me    # encrypts TOTP secrets at rest
RATE_LIMIT_PER_MINUTE=300       # per signed-in user (per IP when anonymous)

# ── Push notifications (docs/INTEGRATIONS.md §4) ──
PUSH_PROVIDER=console           # console | live
FCM_SERVICE_ACCOUNT_JSON_B64=   # base64 of the Firebase service-account JSON (Android)
APNS_KEY_P8_B64=                # base64 of the APNs .p8 auth key (iOS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRODUCTION=false

# ── File storage (§7) ──
STORAGE_DRIVER=local            # local | s3
S3_ENDPOINT=                    # leave empty for AWS; set for MinIO/R2/other S3-compatible
S3_REGION=me-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Routing (§6) ──
ROUTING_PROVIDER=haversine      # haversine | osrm
OSRM_URL=                       # e.g. http://osrm:5000 (see infra/osrm/README.md)
